# Generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=development
JWT_SECRET=
# SQLite is an optional single-process development fallback. Use PostgreSQL for concurrent auth testing.
DATABASE_URL=sqlite:///./faultline.db
JWT_ISSUER=faultline-api
JWT_AUDIENCE=faultline-mobile
ACCESS_MINUTES=10
REFRESH_DAYS=30
ALLOWED_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=300
# Set when using Compose; otherwise leave unset.
# REDIS_URL=redis://localhost:6379/0
# Required by infra/compose.yml. Generate locally; never use example passwords.
POSTGRES_PASSWORD=
