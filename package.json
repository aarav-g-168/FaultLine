{
  "name": "faultline",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "mobile": "npm run start --workspace @faultline/mobile",
    "web": "npm run web --workspace @faultline/mobile",
    "typecheck": "npm run typecheck --workspace @faultline/mobile",
    "test:mobile": "npm run test --workspace @faultline/mobile",
    "api:generate": "openapi-typescript packages/api-client/openapi.json -o packages/api-client/schema.d.ts"
  },
  "devDependencies": {"openapi-typescript": "7.13.0", "@playwright/test": "1.58.2"},
  "engines": {"node": ">=24"}
}
